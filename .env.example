# ===============================================================
# NEO-SCOPE — ENVIRONMENT CONFIGURATION
# ===============================================================

# NASA Open APIs Key
# Register for an official key for free at: https://api.nasa.gov/
# By default, NEO-SCOPE falls back to NASA's public "DEMO_KEY" (30 req/hr).
# An official key provides 1,000 req/hr rate limits.
NASA_API_KEY=your_nasa_api_key_here
NEXT_PUBLIC_NASA_API_KEY=your_nasa_api_key_here
